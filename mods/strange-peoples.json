  {
   "id": "hiveoffer",
   "text": "A cloud of Hivelings swarms your airlock, chattering. One holds up a tiny badge that says 'Hire me'.",
   "weight": 2,
   "minSector": 2,
   "choices": [
    {
     "text": "Take one aboard.",
     "effect": {
      "text": "She salutes, falls over, and gets up again.",
      "crew": "hiveborn"
     }
    },
    {
     "text": "Politely decline.",
     "effect": {
      "text": "The swarm drifts off, still chattering."
     }
    }
   ]
  },
  {
   "id": "embercamp",
   "text": "Ember Kin are roasting something on a drifting furnace. They offer you a seat.",
