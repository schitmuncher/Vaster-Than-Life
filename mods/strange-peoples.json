   "minSector": 3,
   "choices": [
    {
     "text": "Sit and eat.",
     "chance": 0.6,
     "success": {
      "text": "Delicious. One of them asks to join you.",
      "crew": "embermen"
     },
     "fail": {
      "text": "Too spicy. Your crew spends the day in the medbay.",
      "crewLoss": 0,
      "hull": -1
     }
    },
    {
     "text": "Trade for fuel. (10 scrap)",
     "cost": {
      "scrap": 10
     },
     "effect": {
      "text": "They hand over two cans.",
      "fuel": 2
     }
    }
   ]
  },
  {
   "id": "prismsong",
   "text": "Crystal spires hum a single note that makes your teeth ring. A Prismari steps out and offers a trade.",
