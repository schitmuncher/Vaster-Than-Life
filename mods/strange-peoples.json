   "minSector": 3,
   "choices": [
    {
     "text": "Accept the offer.",
     "effect": {
      "text": "They repair a few hull plates and ask for nothing.",
      "hull": 4
     }
    },
    {
     "text": "Ask to join the crew.",
     "effect": {
      "text": "'Yes. Quietly, please.'",
      "crew": "crystalline"
     }
    }
   ]
  },
  {
